# App Config
DEBUG=false
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# InfluxDB Config
INFLUX_URL=http://influxdb:8086
INFLUX_USER=admin
INFLUX_PASSWORD=adminpass
INFLUX_TOKEN=my-super-secret-auth-token
INFLUX_ORG=network-analyzer
INFLUX_BUCKET=network_metrics
INFLUX_BUCKET_ALERTS=alerts

# Redis Config
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
